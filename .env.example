# Meridian environment
#
# Copy to .env (production) or .env.dev (local dev, points PG_* at localhost).
# Credentials never go in the database (spec §11.11) — this file is the only
# place they live. Do not commit the filled-in copy.

DATA_ROOT=/srv/meridian

# --- Postgres --------------------------------------------------------------
# PG_USER / PG_PASSWORD own the database and run migrations. The two role
# passwords are consumed once, by scripts/init-roles.sh at first boot; they must
# match the passwords embedded in the URLs below.
PG_USER=meridian
PG_PASSWORD=
PG_RW_PASSWORD=
PG_RO_PASSWORD=

# Driver-agnostic on purpose — the code coerces these to asyncpg.
# In production these use the compose service name and the container port.
# Locally, point them at localhost:21111 (see docker-compose.dev.yml).
PG_RW_URL=postgresql://meridian_rw:...@postgres:5432/meridian
PG_RO_URL=postgresql://meridian_ro:...@postgres:5432/meridian

# Migrations run as the database owner, not as meridian_rw — default privileges
# only cover objects created by the role that declared them, so running Alembic
# as the wrong role would leave meridian_ro without SELECT on new tables.
PG_MIGRATION_URL=postgresql://meridian:...@postgres:5432/meridian

# Connection pooling. Postgres runs with max_connections=40 shared across every
# service, so raise these only with that budget in mind.
# MERIDIAN_DB_POOL_SIZE=5
# MERIDIAN_DB_MAX_OVERFLOW=5
# MERIDIAN_DB_ECHO=false

# --- Ingestion ---------------------------------------------------------------
CRAWL4AI_TOKEN=

# The search backend (P1-34, spec §6.4). Unset means the worker does not claim
# `query` rows at all — which is a supported state, not an error, but it means
# the frontier can only ever narrow: when the queue drains, the crawl idles
# instead of searching for more. The health line says which state you are in.
SEARXNG_URL=http://searxng:8080
# MERIDIAN_SEARCH_TIMEOUT_S=30        # generous: SearXNG is itself waiting on engines
# MERIDIAN_SEARCH_MAX_RESULTS=50      # cap on what one query row may add to the queue

# Paper full-text resolution (P1-14, spec §6.5). Given a DOI, find a legally
# available copy: Unpaywall, then OpenAlex, then CORE, then the preprint rule.
#
# The contact address is not optional in practice — Unpaywall requires one and
# refuses requests without it, and OpenAlex uses it for the polite pool. Without
# it the chain still works, on OpenAlex and preprints alone, and finds
# materially fewer copies. It is sent to those APIs, so use a role address you
# are happy to publish, the same one as the crawler's user agent.
MERIDIAN_CONTACT_EMAIL=ops@example.org
# CORE_API_KEY=                       # optional; CORE is skipped without one
# SEMANTIC_SCHOLAR_API_KEY=           # optional, and worth having: the anonymous
#                                     # quota throttles hard, and a throttled
#                                     # provider makes the task retry rather than
#                                     # resolve. Free to request.
# MERIDIAN_DOI_TIMEOUT_S=20

# The worker loop (P1-15). All optional; the defaults are the shipped ones.
# Concurrency is claim-fetch-settle lanes, not requests per domain — per-domain
# politeness comes from fetch_policy and is enforced regardless of this number.
# MERIDIAN_WORKER_ID=                 # defaults to hostname + a per-process suffix
# MERIDIAN_WORKER_CONCURRENCY=4
# MERIDIAN_WORKER_IDLE_SLEEP_S=5      # poll interval when the queue is empty
# MERIDIAN_WORKER_LEASE_SECONDS=900
# MERIDIAN_WORKER_TOPICS=             # comma-separated; empty means every topic
# MERIDIAN_WORKER_HOUSEKEEPING_S=3600 # health line + attempt prune; 0 disables
# MERIDIAN_ATTEMPT_RETENTION_DAYS=30
# MERIDIAN_WORKER_MAX_TASKS=          # stop after N tasks; empty runs until signalled

# The raw store (P1-11). In containers this is the bind-mount target and the
# default is already right; set it only when running the worker natively.
# Retention decides what lands here: government, peer-reviewed and institutional
# sources keep the file, press and informal ones keep a checksum and no bytes
# (spec §5.4). `sources.raw_file_path` is relative to this directory, so moving
# the store to a bigger disk is a mount change and not a database migration.
# MERIDIAN_RAW_ROOT=/data/raw

# --- Exposure ----------------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=

# --- Registry (Pi pulls private GHCR images) ---------------------------------
GHCR_READ_PAT=

# --- Orchestrator only: model API keys ---------------------------------------
# Unset ANTHROPIC_API_KEY in any shell running Claude Code against Meridian's
# MCP server for subscription-backed synthesis — if set, Claude Code bills API
# usage instead of drawing on the subscription (spec §11.1a).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OPTIONAL, and off by default. Meridian does not run a local model — §4 chose
# hosted reasoning, and config/agents.yaml ships local-llamacpp as enabled:false.
# Leave these blank unless you actually stand up an OpenAI-compatible endpoint
# and enable that registry row; nothing reads them otherwise.
#
# If you do: run a process dedicated to Meridian rather than sharing the one
# serving editor tooling, so the two don't contend for slots (§11.7).
LOCAL_LLM_URL=
LOCAL_LLM_HEALTH_URL=
LOCAL_LLM_MAC=

# --- Telegram (reporting + control, spec §13.3) -------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
