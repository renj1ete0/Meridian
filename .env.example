# Meridian environment
#
# Copy to .env (production) or .env.dev (local dev, points PG_* at localhost).
# Credentials never go in the database (spec §11.11) — this file is the only
# place they live. Do not commit the filled-in copy.

DATA_ROOT=/srv/meridian

# --- Postgres --------------------------------------------------------------
# PG_USER / PG_PASSWORD own the database and run migrations. The two role
# passwords are consumed once, by scripts/init-roles.sh at first boot; they must
# match the passwords embedded in the URLs below.
PG_USER=meridian
PG_PASSWORD=
PG_RW_PASSWORD=
PG_RO_PASSWORD=
# Optional (P3-07). The read role for anything a guest can reach — someone
# else's model over MCP, or the SQL escape hatch. It gets SELECT on the corpus
# and the graph and nothing else, because meridian_ro can read every table
# including agent_tokens, which holds the only secret in the schema.
#
# Leave blank unless you are sharing. The migration creates the role either way
# and grants it correctly; without a password it simply cannot connect, which is
# the right state for a deployment that shares nothing.
PG_GUEST_PASSWORD=

# Driver-agnostic on purpose — the code coerces these to asyncpg.
# In production these use the compose service name and the container port.
# Locally, point them at localhost:21111 (see docker-compose.dev.yml).
PG_RW_URL=postgresql://meridian_rw:...@postgres:5432/meridian
PG_RO_URL=postgresql://meridian_ro:...@postgres:5432/meridian

# Migrations run as the database owner, not as meridian_rw — default privileges
# only cover objects created by the role that declared them, so running Alembic
# as the wrong role would leave meridian_ro without SELECT on new tables.
PG_MIGRATION_URL=postgresql://meridian:...@postgres:5432/meridian

# Connection pooling. Postgres runs with max_connections=40 shared across every
# service, so raise these only with that budget in mind.
# MERIDIAN_DB_POOL_SIZE=5
# MERIDIAN_DB_MAX_OVERFLOW=5
# MERIDIAN_DB_ECHO=false

# --- Ingestion ---------------------------------------------------------------
CRAWL4AI_TOKEN=

# The search backend (P1-34, spec §6.4). Unset means the worker does not claim
# `query` rows at all — which is a supported state, not an error, but it means
# the frontier can only ever narrow: when the queue drains, the crawl idles
# instead of searching for more. The health line says which state you are in.
SEARXNG_URL=http://searxng:8080
# MERIDIAN_SEARCH_TIMEOUT_S=30        # generous: SearXNG is itself waiting on engines
# MERIDIAN_SEARCH_MAX_RESULTS=50      # cap on what one query row may add to the queue

# Paper full-text resolution (P1-14, spec §6.5). Given a DOI, find a legally
# available copy: Unpaywall, then OpenAlex, then CORE, then the preprint rule.
#
# The contact address is not optional in practice — Unpaywall requires one and
# refuses requests without it, and OpenAlex uses it for the polite pool. Without
# it the chain still works, on OpenAlex and preprints alone, and finds
# materially fewer copies. It is sent to those APIs, so use a role address you
# are happy to publish, the same one as the crawler's user agent.
MERIDIAN_CONTACT_EMAIL=ops@example.org
# CORE_API_KEY=                       # optional; CORE is skipped without one
# SEMANTIC_SCHOLAR_API_KEY=           # optional, and worth having: the anonymous
#                                     # quota throttles hard, and a throttled
#                                     # provider makes the task retry rather than
#                                     # resolve. Free to request.
# MERIDIAN_DOI_TIMEOUT_S=20

# The worker loop (P1-15). All optional; the defaults are the shipped ones.
# Concurrency is claim-fetch-settle lanes, not requests per domain — per-domain
# politeness comes from fetch_policy and is enforced regardless of this number.
# MERIDIAN_WORKER_ID=                 # defaults to hostname + a per-process suffix
# MERIDIAN_WORKER_CONCURRENCY=4
# MERIDIAN_WORKER_IDLE_SLEEP_S=5      # poll interval when the queue is empty
# MERIDIAN_WORKER_LEASE_SECONDS=900
# MERIDIAN_WORKER_TOPICS=             # comma-separated; empty means every topic
# MERIDIAN_WORKER_HOUSEKEEPING_S=3600 # health line + attempt prune; 0 disables
# MERIDIAN_ATTEMPT_RETENTION_DAYS=30
# MERIDIAN_WORKER_MAX_TASKS=          # stop after N tasks; empty runs until signalled

# The raw store (P1-11). In containers this is the bind-mount target and the
# default is already right; set it only when running the worker natively.
# Retention decides what lands here: government, peer-reviewed and institutional
# sources keep the file, press and informal ones keep a checksum and no bytes
# (spec §5.4). `sources.raw_file_path` is relative to this directory, so moving
# the store to a bigger disk is a mount change and not a database migration.
# MERIDIAN_RAW_ROOT=/data/raw

# --- Exposure ----------------------------------------------------------------
# Serve stored raw files (P6-14). OFF unless set. The raw store holds copies of
# third-party material kept as a research archive (§14.2), and serving it is
# redistribution rather than reading — a different act, and a decision.
#
# Needed for §12.5's page-accurate figure links. P3-10's grants.raw_files is the
# per-person version beneath this deployment-level switch.
# MERIDIAN_SERVE_RAW=true

# §12.4's escape hatch (P3-04): a read-only SQL tool for an external agent.
# Unset means the tool is not registered at all — a tool that always fails is
# worse than an absent one, because the tool list is a model's whole view of
# what it can do.
#
# It runs as meridian_guest (P3-07): SELECT on the corpus and the graph, and
# nothing on agent_tokens or fetch_policy. Requires PG_GUEST_PASSWORD above.
# PG_GUEST_URL=postgresql://meridian_guest:...@postgres:5432/meridian

# The embedding sidecar (P2-17). Unset means lexical-only search, reported
# honestly on every response rather than silently — a corpus that looks thin
# because the vector arm never ran is the failure this avoids.
#
# `embedder` is the worker's image with a different command, on `internal`.
#
# The backfill uses it too (P2-19), so a stack running both holds one copy of
# the weights rather than two. If the sidecar is unreachable the backfill loads
# the model in its own process and logs why — a pass is slower and hungrier, not
# stopped. A sidecar naming a *different* model is refused rather than used:
# mixing two models' vectors in one column ranks confident nonsense and nothing
# downstream can detect it.
MERIDIAN_EMBEDDER_URL=http://embedder:8100
# MERIDIAN_EMBEDDER_TIMEOUT_S=30

# The MCP read surface (P3-01, P3-03). Authentication FAILS CLOSED: without a
# verifier configured and without the anonymous opt-out, every tool refuses.
#
# Anonymous is for a loopback development machine only. Setting it on anything
# reachable publishes the corpus to whoever can reach the port.
# MERIDIAN_MCP_ALLOW_ANONYMOUS=true
#
# With credentials, both of these are required — they are the OAuth issuer and
# this server's own resource identifier, and Cloudflare Access supplies the
# first when it fronts the tunnel (P3-05, P3-09).
# MERIDIAN_MCP_ISSUER_URL=https://<your-team>.cloudflareaccess.com
# MERIDIAN_MCP_RESOURCE_URL=https://<your-hostname>/mcp
#
# DNS-rebinding protection. Defaults to loopback, which means a tunnel in front
# is refused until the real hostname is named here — deliberately, so exposure
# is a decision rather than a side effect.
# MERIDIAN_MCP_ALLOWED_HOSTS=<your-hostname>
# MERIDIAN_MCP_ALLOWED_ORIGINS=https://<your-hostname>

# The control surface (P6-13). /api/admin/* is the only part of the API that
# changes anything, and it FAILS CLOSED: without a way to identify callers it
# refuses every request with a 503 naming these variables. Identity comes from
# the Cloudflare Access assertion below — so on an exposed instance, configure
# Access and leave this unset.
#
# Set this ONLY on an instance that is not reachable from outside (a laptop, a
# LAN-only box). It means "there is nobody to authenticate here", not "skip
# authentication".
# MERIDIAN_ADMIN_ALLOW_ANONYMOUS=true

# Cloudflare Access assertion verification (P3-08). Set BOTH when a tunnel
# fronts this service; the middleware is not installed without them.
#
# A team domain without an audience would verify that *some* Access application
# signed the assertion — including one belonging to another service on the same
# team — which is not the same as authenticating for this one.
# CF_ACCESS_TEAM_DOMAIN=<your-team>.cloudflareaccess.com
# CF_ACCESS_AUD=<the Access application's AUD tag>

CLOUDFLARE_TUNNEL_TOKEN=

# --- Semantic Scholar (optional, `P1-35`) -------------------------------------
# Open-access PDF resolution for DOIs. Without a key the provider still answers
# but rate-limits hard, and `docs/handover.md` records what that costs: a 429
# folded in with connection errors made "no open-access copy exists" and "we
# asked too fast" indistinguishable, so papers were never looked for again.
# Free, and the 48h run is when its absence is felt.
SEMANTIC_SCHOLAR_API_KEY=

# --- Registry (Pi pulls private GHCR images) ---------------------------------
GHCR_READ_PAT=

# --- Orchestrator only: model API keys ---------------------------------------
# Read indirectly. The registry row names the variable (`agents.api_key_env_var`)
# and `provider.py` reads it at call time, so the key is never in the database —
# the database is snapshotted off-device and a key stored there travels with
# every snapshot (§11.11).
#
# Needed only for synthesis. The crawl, the corpus and search all work without
# it; a run that cannot find a key refuses that agent and tries the next.
#
# Unset ANTHROPIC_API_KEY in any shell running Claude Code against Meridian's
# MCP server for subscription-backed synthesis — if set, Claude Code bills API
# usage instead of drawing on the subscription (spec §11.1a).
ANTHROPIC_API_KEY=

# Unused unless you add a registry row whose `api_key_env_var` names it. No
# seeded agent does: the hosted tier is Anthropic and the local tier usually
# needs no key at all.
OPENAI_API_KEY=

# OPTIONAL, and off by default. Meridian does not run a local model — §4 chose
# hosted reasoning, and config/agents.yaml ships local-llamacpp as enabled:false.
# Leave these blank unless you actually stand up an OpenAI-compatible endpoint
# and enable that registry row; nothing reads them otherwise.
#
# If you do: run a process dedicated to Meridian rather than sharing the one
# serving editor tooling, so the two don't contend for slots (§11.7).
LOCAL_LLM_URL=
LOCAL_LLM_HEALTH_URL=
LOCAL_LLM_MAC=

# --- Telegram (reporting + control, spec §13.3) -------------------------------
# P5-07's digest and alerts. Both or neither — a token with nowhere to send and
# a chat id that cannot send are two half-configured states that fail
# differently. Unset means the digest still runs, still evaluates conditions and
# still records them to `notifications`; it simply delivers nothing.
#
# §13.3: restrict to a single chat. `TELEGRAM_CHAT_ID` is what the inbound half
# authorises against, and it is checked before a message is even parsed — so an
# unset value refuses every chat rather than allowing any. Setting the token and
# leaving the chat id blank gives you a bot that reports and takes no orders,
# which is a reasonable thing to want.
# MERIDIAN_ALERT_COOLDOWN_H=6      # how long an alert stays quiet after firing
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
