# The embedding node (`P3-12`). Copy to .env beside this file; chmod 600.
# KEY=value with no spaces around `=` — Docker's env-file parser rejects them.

# Required. A long random string, identical on both machines:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MERIDIAN_EMBEDDER_TOKEN=

# Where the 2.3 GB of weights live on this machine.
MODELS_DIR=/srv/meridian/models

# The address the port listens on. 0.0.0.0 is every interface; set it to this
# machine's LAN address to keep it off any other network it is on.
EMBEDDER_BIND=0.0.0.0
EMBEDDER_MEMORY=8G

# Images: the registry and the channel Watchtower follows. `stable` moves only
# when somebody runs `make promote SHA=…` on the build machine.
MERIDIAN_REGISTRY=ghcr.io/renj1ete0
MERIDIAN_TAG=stable

# The cross-encoder that re-orders search results (`B-167`); empty is off. Graded on this
# corpus it took nDCG@10 from 0.60 to 0.78 (docs/features/search.md#reranking), and on a
# GPU it answers in well under a second. `modelfetch` fetches it with the embedder.
MERIDIAN_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Read-only registry access, for private images. A GitHub PAT with
# `read:packages` ONLY — never a token that can write.
GHCR_READ_USER=
GHCR_READ_PAT=

# Optional: where Watchtower says it updated something (a shoutrrr URL), e.g.
#   telegram://<bot token>@telegram/?chats=<chat id>
WATCHTOWER_NOTIFICATION_URL=
WATCHTOWER_POLL_INTERVAL=3600
TZ=Asia/Singapore

# --- The GPU node (`B-225`, gpu.yml) ---------------------------------------
# The local language model, served with `--profile llm`. A Hugging Face GGUF as
# repo:quant, fetched into MODELS_DIR/llm on first start. Size it to the card:
# on 24 GB, about 20 GB is left beside the embedder for weights and context.
LLM_HF=
# The name the server answers to; set LOCAL_LLM_MODEL / LOCAL_CHAT_MODEL (or the
# agent row's model) on the other machine to the same string.
LLM_ALIAS=meridian
# Context per slot × slots is what the KV cache costs on the card.
LLM_CTX=32768
LLM_PARALLEL=2
