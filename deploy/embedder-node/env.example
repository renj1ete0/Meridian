# The embedding node (`P3-12`). Copy to .env beside this file; chmod 600.
# KEY=value with no spaces around `=` — Docker's env-file parser rejects them.

# Required. A long random string, identical on both machines:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MERIDIAN_EMBEDDER_TOKEN=

# Where the 2.3 GB of weights live on this machine.
MODELS_DIR=/srv/meridian/models

# The address the port listens on. 0.0.0.0 is every interface; set it to this
# machine's LAN address to keep it off any other network it is on.
EMBEDDER_BIND=0.0.0.0
EMBEDDER_MEMORY=8G

# Images: the registry and the channel Watchtower follows. `stable` moves only
# when somebody runs `make promote SHA=…` on the build machine.
MERIDIAN_REGISTRY=ghcr.io/renj1ete0
MERIDIAN_TAG=stable

# Read-only registry access, for private images. A GitHub PAT with
# `read:packages` ONLY — never a token that can write.
GHCR_READ_USER=
GHCR_READ_PAT=

# Optional: where Watchtower says it updated something (a shoutrrr URL), e.g.
#   telegram://<bot token>@telegram/?chats=<chat id>
WATCHTOWER_NOTIFICATION_URL=
WATCHTOWER_POLL_INTERVAL=3600
TZ=Asia/Singapore
