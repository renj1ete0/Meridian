{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "oxc",
    "vitest"
  ],
  "jsPlugins": [
    "eslint-plugin-tsdoc"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "typescript/no-explicit-any": "error",
    "tsdoc/syntax": "error",
    "vitest/valid-expect": [
      "error",
      {
        "maxArgs": 2
      }
    ],
    "vitest/require-mock-type-parameters": "off",
    "react/set-state-in-effect": "off",
    "react/refs": "off",
    "react/purity": "off",
    "react/immutability": "off"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**"
  ]
}
